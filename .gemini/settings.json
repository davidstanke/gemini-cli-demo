{
  "hooks": {
    "AfterTool": [
      {
        "matcher": "(write_file|replace)",
        "hooks": [
          {
            "name": "conventional-commit",
            "type": "command",
            "command": "bash .gemini/hooks/conventional-commit.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}
